# LOCAL DEMO ONLY. This file contains public development credentials.
# Copy to .env. Compose already uses these defaults if .env is absent.
DEMO_MODE=true
JWT_SECRET=development-only-sentinelops-signing-key-replace-before-deployment
POSTGRES_PASSWORD=sentinel-local-database-only
LLM_MODE=fixture
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LIVE_TOOLS_ENABLED=false
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Native development (from apps/api), not used by Compose's DATABASE_URL.
DATABASE_URL=sqlite:///./sentinelops.db
ENABLE_PGVECTOR=false
EVAL_REPORT_PATH=../../evals/results/latest.json
OTEL_CONSOLE_EXPORT=false

# Do not use DEMO_MODE=true or this signing key on a public deployment.
# See docs/deployment.md for the explicit production prerequisites.
